# Copy this file to deploy/.env on the server and fill it in. It is not versioned.

# Images (published to GHCR by CI; the deploy job overrides TAG with the commit SHA)
GHCR_OWNER=martinbarreirob
TAG=latest

# Where nginx listens on the host. Public access goes through the Cloudflare Tunnel, not this port.
BIND_ADDR=127.0.0.1
WEB_PORT=8080

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels, or the API). Treat it as a secret.
TUNNEL_TOKEN=CHANGE_ME

# MongoDB: dedicated database and a user with permissions on it only (see deploy/README.md).
MONGO_URI=mongodb://rayrecords:CHANGE_ME@mongodb:27017/rayrecords?authSource=rayrecords
MONGO_DB=rayrecords

# If Mongo lives in another compose project, join the API to its network with the override:
#   docker network ls   -> name of that network
COMPOSE_FILE=docker-compose.yml:docker-compose.mongo-network.yml
MONGO_NETWORK=other-project_default
