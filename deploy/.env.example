# Copia este archivo a deploy/.env en el servidor y rellénalo. No se versiona.

# Imágenes (se publican en GHCR desde CI)
GHCR_OWNER=martinbarreirob
TAG=latest

# Dónde escucha nginx. 127.0.0.1 + `tailscale serve --bg 8080` da HTTPS solo dentro de la tailnet.
# Alternativa sin tailscale serve: la IP 100.x.y.z de la máquina en la tailnet.
BIND_ADDR=127.0.0.1
WEB_PORT=8080

# MongoDB: BD propia y usuario con permisos solo sobre ella (ver deploy/README.md).
MONGO_URI=mongodb://rayrecords:CAMBIAR@mongo:27017/rayrecords?authSource=rayrecords
MONGO_DB=rayrecords

# Si el Mongo vive en otro compose, une la API a su red con el override:
#   docker network ls   → nombre de esa red
COMPOSE_FILE=docker-compose.yml:docker-compose.mongo-network.yml
MONGO_NETWORK=otro-proyecto_default
