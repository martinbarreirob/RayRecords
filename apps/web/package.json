{
  "name": "@rayrecords/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "license": "node scripts/write-license.mjs",
    "start": "node scripts/write-license.mjs && ng serve --port 4300 --proxy-config proxy.conf.json",
    "build": "node scripts/write-license.mjs && ng build",
    "watch": "node scripts/write-license.mjs && ng build --watch --configuration development",
    "test": "node scripts/write-license.mjs && ng test --no-watch",
    "icons": "node scripts/generate-icons.mjs",
    "icons:tabler": "node scripts/generate-tabler-icons.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@primeuix/themes": "^3.1.0",
    "@rayrecords/shared": "workspace:*",
    "primeicons": "^8.0.2",
    "primeng": "22.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@tabler/icons": "^3.52.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
