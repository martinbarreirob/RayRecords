# Copy to apps/api/.env for local development (not committed).
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017
# The seeder only works with names ending in _dev or _demo.
MONGO_DB=rayrecords_dev
LOG_LEVEL=info
# Extra origins accepted on state-changing requests (comma-separated). Usually empty.
# ALLOWED_ORIGINS=
# User created by `pnpm seed` (defaults to the one in apps/api/src/seed/user.ts).
# SEED_USERNAME=
# SEED_PASSWORD=
