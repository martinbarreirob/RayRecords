{
  "name": "@rayrecords/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "seed": "tsx --env-file-if-exists=.env src/seed/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "mongodb": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rayrecords/shared": "workspace:*",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
