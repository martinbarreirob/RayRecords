{
  "name": "rayrecords",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:db": "docker compose -f deploy/compose.dev.yml up -d",
    "dev:api": "pnpm --filter @rayrecords/api dev",
    "dev:web": "pnpm --filter @rayrecords/web start",
    "seed": "pnpm --filter @rayrecords/api seed",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
